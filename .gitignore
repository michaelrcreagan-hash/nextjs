# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# CBT generated artifacts
strategies/*/Data/panel.parquet
__pycache__/
*.pyc
strategies/*/Data/h4/*.csv
strategies/*/Data/futures/*.csv
strategies/*/Data/macro/*.csv

# Prevent newly generated personal-account snapshots and local broker exports.
# NOTE: already tracked historical files remain in Git until separately purged.
strategies/hermes_agent/Data/real_accounts/**
**/private_account_exports/**
**/*broker_statement*.csv
**/*tax_lots*.csv
